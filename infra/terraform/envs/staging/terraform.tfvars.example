environment  = "staging"
region       = "eu-central-1"
name_prefix  = "hosting"
network_cidr = "10.20.0.0/16"
dns_zone     = "staging.example.com"

dns_records = [
  {
    name  = "app"
    type  = "CNAME"
    value = "replace-with-staging-ingress.example.net"
    ttl   = 300
  },
  {
    name  = "*.apps"
    type  = "CNAME"
    value = "replace-with-staging-runtime-ingress.example.net"
    ttl   = 300
  }
]

database = {
  engine_version        = "16"
  instance_class        = "small"
  storage_gb            = 50
  backup_retention_days = 7
  high_availability     = false
}

redis = {
  engine_version    = "7"
  instance_class    = "small"
  high_availability = false
}

rabbitmq = {
  engine_version    = "3.13"
  instance_class    = "small"
  high_availability = false
}

object_storage = {
  bucket_name            = "replace-with-staging-platform-bucket"
  versioning_enabled     = true
  object_lock_enabled    = false
  retention_days         = 30
  server_side_encryption = true
  deployment_prefix      = "deployments/"
  backup_prefix          = "backups/"
}

kubernetes = {
  version = "1.30"
  node_pools = {
    system = {
      instance_type = "small"
      min_size      = 1
      max_size      = 3
      desired_size  = 1
    }
    runtime = {
      instance_type = "medium"
      min_size      = 1
      max_size      = 5
      desired_size  = 2
    }
  }
  private_endpoint   = true
  audit_logs_enabled = true
}

registry = {
  name                   = "hosting-staging"
  immutable_tags         = true
  vulnerability_scanning = true
  retention_days         = 30
}

secrets = {
  provider_name            = "replace-with-secrets-manager"
  key_rotation_days        = 90
  external_secrets_enabled = true
}

monitoring = {
  prometheus_enabled = true
  grafana_enabled    = true
  loki_enabled       = true
  retention_days     = 14
  alert_email        = "platform-alerts-staging@example.com"
}
