# Django environment
DJANGO_ENV=production
DJANGO_SECRET_KEY=change-me-use-a-long-random-secret
DJANGO_ALLOWED_HOSTS=app.example.com,api.example.com

# Database
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=saas_platform

# HTTPS and cookies
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax

# Browser and cross-origin policy
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# Backup and restore
BACKUP_OUTPUT_DIR=/var/backups/saas-platform
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=change-me-generate-with-fernet-or-secret-manager
BACKUP_PLATFORM_CONFIG_KEYS=DJANGO_SETTINGS_MODULE,DJANGO_ALLOWED_HOSTS,STATIC_DEPLOYMENT_STORAGE_BACKEND,STATIC_DEPLOYMENT_S3_BUCKET,STATIC_DEPLOYMENT_S3_REGION
BACKUP_SECRET_FINGERPRINT_KEYS=DJANGO_SECRET_KEY,BACKUP_ENCRYPTION_KEY,PROJECT_SECRET_ENCRYPTION_KEY,STRIPE_SECRET_KEY,STRIPE_WEBHOOK_SECRET
